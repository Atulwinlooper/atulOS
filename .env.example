# Copy this file to .env and fill it in. .env is git-ignored; never commit it.
# Note: VITE_* values are built into the site's JavaScript, so they are still visible on the
# live site. .env only keeps them out of the repository.

# The site's public address, for link previews (og:image) and the canonical URL.
VITE_SITE_URL=https://your-name.pages.dev

# Shown in Mail, on the back of the ID card and in the résumé. Leave empty to hide.
VITE_CONTACT_EMAIL=you@example.com

# Shown only in the résumé (PDF, Word and the in-app preview). Leave empty to hide.
VITE_CONTACT_PHONE=
